{
  "name": "@tetsup/rpg2d-workspace",
  "version": "0.0.0",
  "license": "MIT",
  "author": "tetsup",
  "repository": {
    "type": "git",
    "url": "https://github.com/tetsup/rpg2d"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev:api": "pnpm --filter @tetsup/rpg2d-api dev",
    "dev:runtime": "pnpm --filter @tetsup/rpg2d-runtime dev",
    "dev:editor": "pnpm --filter @tetsup/rpg2d-editor dev",
    "dev:play": "concurrently -n api,runtime \"pnpm dev:api\" \"pnpm dev:runtime\"",
    "dev:edit": "concurrently -n api,runtime,editor \"pnpm dev:api\" \"pnpm dev:runtime\" \"pnpm dev:editor\"",
    "lint": "eslint",
    "typecheck": "pnpm -r typecheck",
    "test:schema": "pnpm --filter @tetsup/rpg2d-schema test",
    "test:engine": "pnpm --filter @tetsup/rpg2d-engine test",
    "test:database": "pnpm --filter @tetsup/rpg2d-database test",
    "test:api": "pnpm --filter @tetsup/rpg2d-api test",
    "test:editor": "pnpm --filter @tetsup/rpg2d-editor test",
    "test": "pnpm test:schema && pnpm test:engine && pnpm test:database && pnpm test:api",
    "build:runtime": "pnpm --filter @tetsup/rpg2d-runtime build",
    "build:landing": "pnpm --filter @tetsup/rpg2d-landing build",
    "build:landing:aws": "pnpm --filter @tetsup/rpg2d-landing build:aws",
    "build:editor": "pnpm --filter @tetsup/rpg2d-editor build",
    "build:editor:aws": "pnpm --filter @tetsup/rpg2d-editor build:aws",
    "build:api:aws": "pnpm --filter @tetsup/rpg2d-api build:aws",
    "build:aws": "pnpm build:landing:aws && pnpm build:editor:aws && pnpm build:api:aws",
    "write-runtime-config": "node scripts/write-runtime-config.mjs",
    "db:migrate": "pnpm --filter @tetsup/rpg2d-database migrate",
    "deps:build": "tsx scripts/deps-graph.ts",
    "deps:dev": "pnpm --filter @tetsup/deps-graph dev"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "concurrently": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "ts-morph": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
