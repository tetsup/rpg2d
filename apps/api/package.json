{
  "name": "@tetsup/rpg2d-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "build:aws": "node scripts/build-lambda.mjs && rm -rf ../../infra/terraform/artifacts/backend/* && mkdir -p ../../infra/terraform/artifacts/backend && zip -j ../../infra/terraform/artifacts/backend/lambda-api.zip ./dist/lambda/index.cjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@auth0/auth0-spa-js": "catalog:",
    "@aws-sdk/client-ssm": "catalog:",
    "@hono/zod-validator": "catalog:",
    "hono": "catalog:",
    "jose": "catalog:",
    "openid-client": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@hono/vite-dev-server": "catalog:",
    "chokidar": "catalog:",
    "tsx": "catalog:",
    "esbuild": "catalog:"
  }
}
