{
  "ignoreDeprecations": "6.0",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@sharedTypes/*": ["packages/shared/src/types/*"],
      "@schema/*": ["packages/shared/src/schema/*"],
      "@engine/*": ["packages/engine/src/*"],
      "@database/*": ["packages/database/src/*"],
      "@api/*": ["apps/api/src/*"],
      "@editor/*": ["apps/editor/src/*"],
      "@runtime/*": ["apps/runtime/src/*"]
    }
  },
  "include": ["./**/*.ts"]
}
