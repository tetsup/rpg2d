{
  "name": "@tetsup/rpg2d-database",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:create": "node-pg-migrate --node-options --env-file-if-exists=.env create",
    "migrate": "node-pg-migrate --node-options --env-file-if-exists=.env up",
    "migrate:down": "node-pg-migrate --node-options --env-file-if-exists=.env down"
  },
  "dependencies": {
    "kysely": "^0.29.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "node-pg-migrate": "^8.0.4"
  }
}
