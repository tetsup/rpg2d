{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@sharedTypes/*": ["types/*"],
      "@engine/*": ["packages/engine/src/*"],
      "@schema/*": ["packages/schema/src/*"],
      "@database/*": ["packages/database/src/*"],
      "@api/*": ["apps/api/src/*"],
      "@editor/*": ["apps/editor/src/*"],
      "@runtime/*": ["apps/runtime/src/*"]
    }
  }
}
