# Copy this file to the repository root as `.env`.
#
# Local development loads env from here (not apps/api/.env):
# - API: apps/api/vite.config.ts (`loadEnv` from repo root)
# - Database: `pnpm db:migrate` and integration tests
#
# Start PostgreSQL first: `docker compose up postgres`

# PostgreSQL (credentials match docker-compose.yml)
DATABASE_URL=postgresql://rpg2d:rpg2d@127.0.0.1:5432/rpg2d # pragma: allowlist secret

# Auth0 (API login)
AUTH0_DOMAIN=dev-xxxxxxxxxxxxxxxx.us.auth0.com
AUTH0_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AUTH0_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Editor origin (OAuth redirect after login, CORS allowlist)
FRONTEND_ORIGIN=http://localhost:5173

# Session cookie signing secret (32+ chars; generate with: openssl rand -base64 32)
SESSION_SECRET=dev-only-session-secret-at-least-32-chars
